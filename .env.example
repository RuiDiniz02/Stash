# Supabase project settings → API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) — safe for the browser, protected by RLS.
# A legacy "anon" key also works here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Public URL of the deployed app (used for auth email redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# No service-role / secret key is needed. Never add one with a NEXT_PUBLIC_ prefix.
